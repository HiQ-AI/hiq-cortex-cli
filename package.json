{
  "name": "@hiq-ai/hiq-cortex-cli",
  "version": "0.1.5",
  "description": "CLI for HiQ Cortex — look up real LCA emission factors from 18 life-cycle inventory databases and 24,000+ published EPDs.",
  "type": "module",
  "bin": {
    "hiq-cortex": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/stamp-version.mjs",
    "build": "tsc",
    "build:bin": "./scripts/build-binaries.sh",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lca",
    "carbon-footprint",
    "emission-factor",
    "ecoinvent",
    "epd",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiQ-AI/hiq-cortex-cli.git"
  },
  "homepage": "https://github.com/HiQ-AI/hiq-cortex-cli",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "qrcode-terminal": "^0.12.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
